{
  "name": "@zerobias-org/login-auditcrowd",
  "version": "1.0.0",
  "type": "module",
  "author": "luis.sejas.mendez@gmail.com",
  "license": "ISC",
  "description": "Custom ZeroBias login page for AuditCrowd by Running Bull (re-cut from login-starter)",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "node ./node_modules/@zerobias-com/dana-login-sdk/metalsmith.js",
    "build:local": "node ./node_modules/@zerobias-com/dana-login-sdk/metalsmith.js --local",
    "dev": "npm run build:local && node server.js",
    "dev:qa": "PROXY_TARGET=https://api.qa.zerobias.com npm run dev",
    "dev:prod": "PROXY_TARGET=https://api.app.zerobias.com npm run dev",
    "start": "npm run build:local && npx http-server dist -p 8080"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/login.git",
    "directory": "package/auditcrowd/"
  },
  "dependencies": {
    "@zerobias-com/dana-login-sdk": "^1.0.80"
  },
  "devDependencies": {
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5"
  }
}
